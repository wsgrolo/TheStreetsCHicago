{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npx pnpm --filter @workspace/windy-city run dev",
    "build": "npx pnpm run typecheck && npx pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "npx pnpm run typecheck:libs && npx pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:generate": "drizzle-kit generate"
  },
  "private": true,
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "drizzle-orm": "1.0.0-beta.22"
  },
  "devDependencies": {
    "@netlify/functions": "^5.0.0",
    "drizzle-kit": "1.0.0-beta.22",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
